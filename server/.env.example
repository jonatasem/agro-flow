# Porta em que o servidor Fastify irá rodar
PORT=3333

# URL do Frontend permitida pelo CORS (ex: ambiente de desenvolvimento ou produção)
URL_PROD=http://localhost:3000

# String de conexão com o Banco de Dados MongoDB (via Prisma ORM)
DATABASE_URL="mongodb+srv://usuario:sua_senha@cluster.mongodb.net/agroflow?retryWrites=true&w=majority"

# Chave secreta utilizada para assinar e validar os tokens JWT
JWT_SECRET="sua_chave_secreta_super_segura_aqui"